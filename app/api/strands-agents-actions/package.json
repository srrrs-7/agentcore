    "@packages/bedrock-agent-utils": "workspace:*",
    "@packages/logger": "workspace:*",
    "@packages/request-utils": "workspace:*",
    "mathjs": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
