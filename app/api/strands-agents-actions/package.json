{
  "name": "@app/strands-agents-actions",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node --format=esm && echo '{\"type\":\"module\"}' > dist/package.json",
