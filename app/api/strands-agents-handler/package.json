{
  "name": "@app/strands-agents-handler",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node --format=esm --external '@aws-sdk/*' && echo '{\"type\":\"module\"}' > dist/package.json",
    "check:type": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.750.0",
    "@aws-sdk/client-bedrock-runtime": "^3.750.0",
    "@packages/aws-config": "workspace:*",
    "@packages/lambda-http": "workspace:*",
    "@packages/logger": "workspace:*",
    "@packages/request-utils": "workspace:*",
    "@packages/sse-utils": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^25.2.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
