# Environment name (used for resource naming and tagging)
environment = "dev"

# AWS Configuration
aws_region = "ap-northeast-1"

# Bedrock Model Configuration
# Use inference profile ID for Nova models (required for on-demand throughput)
# Options:
#   - "apac.amazon.nova-micro-v1:0"  (APAC regions including ap-northeast-1)
#   - "us.amazon.nova-micro-v1:0"    (US regions)
#   - "eu.amazon.nova-micro-v1:0"    (EU regions)
#   - "anthropic.claude-3-haiku-20240307-v1:0" (direct model ID)
foundation_model = "apac.amazon.nova-micro-v1:0"

# CORS Configuration
# Set to specific origins in production (e.g., ["https://your-app.com"])
allowed_origins = ["*"]

# Optional: Email for alerts
# alert_email = "your-email@example.com"

# Optional: Tavily API key for web search
# Get your API key at https://tavily.com
# websearch_api_key = "tvly-xxxxxxxxxxxx"

# Optional: Additional tags for all resources
# tags = {
#   CostCenter = "engineering"
#   Owner      = "team-name"
# }
