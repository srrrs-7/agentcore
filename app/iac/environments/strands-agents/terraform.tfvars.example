# Environment name (used for resource naming and tagging)
environment = "dev"

# AWS Configuration
aws_region = "ap-northeast-1"

# CORS Configuration
# Set to specific origins in production (e.g., ["https://your-app.com"])
allowed_origins = ["*"]

# Optional: Email for alerts
# alert_email = "your-email@example.com"

# Optional: Tavily API key for web search
# Get your API key at https://tavily.com
# websearch_api_key = "tvly-xxxxxxxxxxxx"

# Optional: Additional tags for all resources
# tags = {
#   CostCenter = "engineering"
#   Owner      = "team-name"
# }
